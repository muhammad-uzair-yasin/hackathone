# Copy to .env and restart Expo: npx expo start -c
#
# Same PC — Web or iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:8000
#
# Android Emulator (localhost on the emulator is NOT your PC):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# Physical phone on Wi‑Fi (use your PC's LAN IP, ipconfig / ifconfig):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
